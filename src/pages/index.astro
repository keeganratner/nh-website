---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StakeCard from '../components/StakeCard.astro';
import { site, home } from '../data/site.js';
import mark from '../assets/nh-mark.svg';

const pathways = (
  await getCollection('pathways', ({ data }) => !data.unlisted)
).sort((a, b) => a.data.order - b.data.order);
---

<Base title={site.title} description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>
          {home.headingLead}<span class="gradient-text">{home.headingAccent}</span>
        </h1>
        <p class="lede">{home.lede}</p>
      </div>
      <aside class="hero-panel">
        <div class="hero-panel-inner">
          <img
            class="hero-panel-mark"
            src={mark.src}
            width={mark.width}
            height={mark.height}
            alt=""
          />
          <h2 class="panel-title">{home.panelTitle}</h2>
          <ul class="status-list">
            {
              home.status.map(([surface, state]) => (
                <li>
                  <span>{surface}</span>
                  <span class="tag">{state}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="pathways">
    <div class="container">
      <div class="section-head">
        <h2>{home.sectionHeading}</h2>
      </div>
      <div class="cards">
        {
          pathways.map((p, i) => (
            <StakeCard
              slug={p.id}
              label={p.data.label}
              hook={p.data.hook}
              tone={i % 3}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 86px 0 70px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 44px;
    align-items: center;
  }

  h1 {
    font-size: clamp(48px, 8vw, 96px);
    line-height: var(--nh-line-heights-headlines-xl);
    letter-spacing: var(--nh-letter-spacing-headlines-xl);
    max-width: 980px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #fff 0%, #d9ccff 24%, #fb7db6 62%, #ffb18d 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    margin-top: 26px;
    color: var(--nh-theme-fg-muted);
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.45;
    max-width: 770px;
  }

  .hero-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--nh-theme-line);
    border-radius: var(--nh-radii-lg);
    padding: 30px;
    min-height: 390px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.045));
    box-shadow: var(--nh-shadow-panel);
  }

  .hero-panel::before {
    content: '';
    position: absolute;
    inset: -40%;
    filter: blur(6px);
    background:
      radial-gradient(circle, rgba(138, 88, 255, 0.25), transparent 36%),
      radial-gradient(circle at 70% 20%, rgba(240, 105, 173, 0.22), transparent 30%);
  }

  .hero-panel-inner {
    position: relative;
    z-index: 1;
  }

  .hero-panel-mark {
    width: 72px;
    height: auto;
    margin-bottom: 26px;
  }

  .panel-title {
    font-size: 22px;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }

  .status-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    color: var(--nh-theme-fg-muted);
    font-size: 15px;
    line-height: 1.35;
  }

  .status-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .tag {
    flex: none;
    border: 1px solid var(--nh-theme-line);
    background: rgba(0, 0, 0, 0.18);
    color: var(--nh-theme-fg-muted);
    border-radius: var(--nh-radii-rounded);
    padding: 8px 10px;
    font-size: 12px;
  }

  .pathways {
    padding: 18px 0 var(--nh-spacing-xxl);
  }

  .section-head {
    margin-bottom: 28px;
  }


  .section-head h2 {
    font-size: clamp(34px, 4.8vw, 62px);
    line-height: 0.98;
  }


  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 940px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-panel {
      min-height: auto;
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 56px;
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
