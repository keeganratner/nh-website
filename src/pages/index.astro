---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---

<Base title={site.title} description={site.description}>
  <div class="lander"></div>
</Base>

<style>
  /* Holds the viewport open so the footer sits at the foot of the page. */
  .lander {
    min-height: 100vh;
  }
</style>
