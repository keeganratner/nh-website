---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SidePanel from '../components/SidePanel.astro';
import EssaySection from '../components/EssaySection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { splitSections } from '../lib/sections.js';

export async function getStaticPaths() {
  const pathways = await getCollection('pathways');
  return pathways.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;

const { intro, sections } = splitSections(entry.rendered?.html);
const audience = data.kicker.replace(/^For /, '');

const related = (await getCollection('pathways', (p) => !p.data.unlisted))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<Base
  title={`${data.label} — Neighbourhoods`}
  description={data.subtitle}
  current={entry.id}
  noindex={data.unlisted}
>
  <article>
    <section class="page-hero">
      <div class="container">
        {
          !data.unlisted && (
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <a href="/">Stakeholder paths</a>
              <span aria-hidden="true">/</span>
              <span>{data.kicker}</span>
            </nav>
          )
        }
        <p class="kicker" transition:name={`title-${entry.id}`}>{data.kicker}</p>
        <h1 class="page-title">{data.title}</h1>
        <p class="page-subtitle">{data.subtitle}</p>
      </div>
    </section>

    <section class="page-body">
      <div class="container body-grid">
        <SidePanel audience={audience} related={data.unlisted ? [] : related} />

        <div class="content">
          <EssaySection html={intro} />

          {
            sections.map((section) => (
              <EssaySection heading={section.heading} html={section.html} />
            ))
          }

          <section class="feature-grid">
            {
              data.cards.map((card) => (
                <FeatureCard title={card.title} body={card.body} />
              ))
            }
          </section>

          <CtaBlock cta={data.cta} />
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .page-hero {
    padding: 72px 0 54px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--nh-theme-fg-subtle);
    font-size: 13px;
    margin-bottom: 28px;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.76);
    text-decoration: none;
  }

  .page-title {
    font-size: clamp(46px, 6.5vw, 90px);
    line-height: var(--nh-line-heights-headlines-xl);
    letter-spacing: var(--nh-letter-spacing-headlines-xl);
    max-width: 990px;
  }

  .page-subtitle {
    margin-top: 24px;
    color: var(--nh-theme-fg-muted);
    font-size: clamp(18px, 2vw, 25px);
    line-height: 1.45;
    max-width: 820px;
  }

  .page-body {
    padding: 18px 0 var(--nh-spacing-xxl);
  }

  .body-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: var(--nh-spacing-lg);
    align-items: start;
  }

  .content {
    display: grid;
    gap: 18px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 940px) {
    .body-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      padding-top: 50px;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
