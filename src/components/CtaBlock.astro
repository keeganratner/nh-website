---
import { site } from '../data/site.js';

const { cta } = Astro.props;
---

<section class="cta-block panel">
  <p>{cta}</p>
  <a class="btn" href={site.contact}>Start a conversation</a>
</section>

<style>
  .cta-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    background: linear-gradient(
      135deg,
      rgba(138, 88, 255, 0.28),
      rgba(240, 105, 173, 0.2),
      rgba(255, 255, 255, 0.06)
    );
  }

  p {
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.3;
    letter-spacing: var(--nh-letter-spacing-headlines);
    max-width: 30ch;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: var(--nh-radii-rounded);
    padding: 14px 18px;
    background: #fff;
    color: #11111a;
    font-weight: var(--nh-font-weights-body-bold);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 18px 50px rgba(255, 255, 255, 0.16);
  }

  .btn::after {
    content: '→';
  }

  @media (max-width: 640px) {
    .cta-block {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
