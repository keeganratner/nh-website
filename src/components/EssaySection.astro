---
const { heading, html } = Astro.props;
---

<section class="essay-section panel">
  {heading && <h2>{heading}</h2>}
  <div class="prose" set:html={html} />
</section>

<style>
  h2 {
    font-size: clamp(30px, 3.6vw, 46px);
    margin-bottom: 16px;
  }

  /* Rendered from Markdown, so the children carry no scope attribute. */
  .prose :global(p) {
    color: rgba(255, 255, 255, 0.76);
    font-size: 18px;
    line-height: var(--nh-line-heights-body-relaxed);
  }

  .prose :global(p + p) {
    margin-top: 16px;
  }

  .prose :global(a) {
    color: var(--nh-theme-accent-default);
  }

  .prose :global(strong) {
    font-weight: var(--nh-font-weights-body-bold);
  }
</style>
