---
const { slug, label, hook, tone = 0 } = Astro.props;
---

<a class={`stake-card tone-${tone}`} href={`/${slug}/`}>
  <div>
    <h3 transition:name={`title-${slug}`}>{label}</h3>
    <p>{hook}</p>
  </div>
  <span class="arrow">Open this pathway</span>
</a>

<style>
  .stake-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 230px;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--nh-radii-md);
    text-decoration: none;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.095), rgba(255, 255, 255, 0.045));
    transition: transform 0.22s ease, background 0.22s ease, border-color 0.22s ease;
  }

  /* The glow that separates one card from its neighbours. An ellipse, not a
     circle: a circle is sized to the box's farthest corner, so in a box this
     wide it is still opaque where it meets the top edge and clips into a hard
     line. The ellipse fades out well inside the box on every axis. */
  .stake-card::before {
    content: '';
    position: absolute;
    inset: auto -20% -60% 10%;
    height: 280px;
    filter: blur(6px);
    background: radial-gradient(ellipse at 50% 60%, var(--glow), transparent 60%);
  }

  .tone-0 {
    --glow: rgba(138, 88, 255, 0.36);
  }

  .tone-1 {
    --glow: rgba(240, 105, 173, 0.32);
  }

  .tone-2 {
    --glow: rgba(138, 155, 244, 0.32);
  }

  .stake-card:hover {
    transform: translateY(-5px);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
    border-color: var(--nh-theme-line-strong);
  }

  h3,
  p {
    position: relative;
  }

  h3 {
    font-size: 25px;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  p {
    color: var(--nh-theme-fg-muted);
    margin-bottom: 22px;
  }

  .arrow {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 14px;
    font-weight: var(--nh-font-weights-body-bold);
  }

  .arrow::after {
    content: '→';
    transition: transform 0.2s ease;
  }

  .stake-card:hover .arrow::after {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .stake-card {
      min-height: 185px;
    }
  }
</style>
