---
const { slug, label, hook, tone = 0 } = Astro.props;
---

<a class={`stake-card tone-${tone}`} href={`/${slug}/`}>
  <h3>
    <span transition:name={`title-${slug}`}>{label}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </h3>
  <p>{hook}</p>
</a>

<style>
  .stake-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--nh-radii-md);
    text-decoration: none;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.095), rgba(255, 255, 255, 0.045));
    transition: transform 0.22s ease, background 0.22s ease, border-color 0.22s ease;
  }

  /* Ellipse, not circle: a circle sizes to the farthest corner and stays
     opaque at the top edge, clipping to a hard line. Offsets in px so the
     glow holds position at any grid row height. */
  .stake-card::before {
    content: '';
    position: absolute;
    inset: auto -20% -140px 10%;
    height: 280px;
    filter: blur(6px);
    background: radial-gradient(ellipse at 50% 60%, var(--glow), transparent 60%);
  }

  .tone-0 {
    --glow: rgba(138, 88, 255, 0.36);
  }

  .tone-1 {
    --glow: rgba(240, 105, 173, 0.32);
  }

  .tone-2 {
    --glow: rgba(138, 155, 244, 0.32);
  }

  .stake-card:hover {
    transform: translateY(-5px);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
    border-color: var(--nh-theme-line-strong);
  }

  h3,
  p {
    position: relative;
  }

  h3 {
    font-size: 25px;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  /* inline-block: follows the last word when the label wraps, and transforms. */
  .arrow {
    display: inline-block;
    margin-left: 10px;
    font-size: 18px;
    transition: transform 0.2s ease;
  }

  .stake-card:hover .arrow {
    transform: translateX(4px);
  }

  p {
    color: var(--nh-theme-fg-muted);
  }
</style>
