---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { navSlugs } from '../data/site.js';
import mark from '../assets/nh-mark.svg';
import wordmark from '../assets/nh-wordmark.png';

const { current } = Astro.props;

const pathways = await getCollection('pathways', ({ data }) => !data.unlisted);
const links = navSlugs
  .map((slug) => pathways.find((p) => p.id === slug))
  .filter(Boolean);
---

<header class="site-header">
  <nav class="nav">
    <a class="brand" href="/">
      <img
        class="brand-mark"
        src={mark.src}
        width={mark.width}
        height={mark.height}
        alt=""
      />
      <Image
        class="brand-word"
        src={wordmark}
        width={320}
        alt="Neighbourhoods"
        loading="eager"
      />
    </a>
    <div class="nav-links">
      <a class="pill nav-home" href="/">Stakeholder paths</a>
      {
        links.map((p) => (
          <a
            class="pill"
            href={`/${p.id}/`}
            aria-current={current === p.id ? 'page' : undefined}
          >
            {p.data.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(18px);
    background: linear-gradient(180deg, rgba(5, 5, 9, 0.78), rgba(5, 5, 9, 0.52));
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .nav {
    max-width: var(--nh-measure-max);
    margin: 0 auto;
    padding: 18px var(--nh-spacing-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }

  .brand-mark {
    width: 42px;
    height: auto;
  }

  .brand-word {
    height: 22px;
    width: auto;
    opacity: 0.96;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .pill {
    border: 1px solid var(--nh-theme-line);
    background: rgba(255, 255, 255, 0.055);
    color: rgba(255, 255, 255, 0.82);
    border-radius: var(--nh-radii-rounded);
    padding: 10px 14px;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pill:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-1px);
  }

  .pill[aria-current='page'] {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--nh-theme-line-strong);
  }

  @media (max-width: 640px) {
    .nav {
      padding: 14px 16px;
    }

    .brand-word {
      display: none;
    }

    .pill:not(.nav-home) {
      display: none;
    }
  }
</style>
