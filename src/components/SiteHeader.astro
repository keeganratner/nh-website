---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { navSlugs } from '../data/site.js';
import mark from '../assets/nh-mark.svg';
import wordmark from '../assets/nh-wordmark.png';

const { current } = Astro.props;

const pathways = await getCollection('pathways', ({ data }) => !data.unlisted);
const links = navSlugs
  .map((slug) => pathways.find((p) => p.id === slug))
  .filter(Boolean);
---

<header class="site-header">
  <nav class="nav">
    <a class="brand" href="/">
      <img
        class="brand-mark"
        src={mark.src}
        width={mark.width}
        height={mark.height}
        alt=""
      />
      <Image
        class="brand-word"
        src={wordmark}
        width={320}
        alt="Neighbourhoods"
        loading="eager"
      />
    </a>
    <div class="nav-links">
      {
        links.map((p) => (
          <a
            class="pill"
            href={`/${p.id}/`}
            aria-current={current === p.id ? 'page' : undefined}
          >
            {p.data.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  // 0 at the top of the page, 1 once the reader is RAMP px in. The header's
  // tint, blur and feather all read from it. Above 1, EASE holds the morph
  // back over the first part of the ramp and lets it accelerate into the end.
  const RAMP = 120;
  const EASE = 2;
  const root = document.documentElement;

  const paint = () => {
    const travel = Math.min(Math.max(window.scrollY, 0) / RAMP, 1);
    root.style.setProperty('--nh-scroll-depth', String(travel ** EASE));
    // The hairline belongs to the closed bar, not to the morph: a state, not
    // a position on the ramp.
    root.style.setProperty('--nh-scroll-closed', travel === 1 ? '1' : '0');
  };

  let queued = false;

  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      paint();
    });
  };

  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('astro:page-load', paint);

  paint();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;

    /* Softness of the edge that travels down the bar. */
    --feather: 65px;

    /* The surface at rest, as a fraction of its full strength. */
    --tint: calc(0.7 + 0.3 * var(--nh-scroll-depth, 0));

    /* How far a bounce travels before the gutter above is fully dark. */
    --gutter-fade: 30vh;

    /* The travelling edge: on the bar's top line at rest, on its bottom line
       once the morph completes. There the remaining softness runs off the end
       of the box, closing the edge. */
    --edge: calc(
      var(--nh-overscroll-reach) + var(--nh-scroll-depth, 0) *
        (100% - var(--nh-overscroll-reach))
    );

    /* Gated on the closed state, so it lands on a finished bar. The fade only
       ever runs at that boundary, which keeps the arrival from snapping. */
    border-bottom: 1px solid
      rgba(255, 255, 255, calc(var(--nh-bar-line) * var(--nh-scroll-closed, 0)));
    transition: border-color 0.15s ease;
  }

  /* One tinted layer behind the nav, so the soft edge never touches the
     wordmark or the links. Alpha and blur deepen with scroll depth while the
     mask walks the edge down the bar, so the surface arrives top line first.

     Above the bar it carries on past the top of the document, darkening with
     distance, so a deeper bounce reveals a deeper tint. */
  .site-header::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1 * var(--nh-overscroll-reach));
    bottom: 0;
    z-index: -1;
    backdrop-filter: blur(calc(var(--nh-scroll-depth, 0) * var(--nh-bar-blur)));
    background: linear-gradient(
      180deg,
      rgba(5, 5, 9, 0.92) 0 calc(var(--nh-overscroll-reach) - var(--gutter-fade)),
      rgba(5, 5, 9, calc(var(--nh-bar-edge) * var(--tint))) var(--nh-overscroll-reach),
      rgba(5, 5, 9, calc(var(--nh-bar-inner) * var(--tint))) 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0 var(--edge),
      transparent calc(var(--edge) + var(--feather))
    );
    mask-image: linear-gradient(
      180deg,
      #000 0 var(--edge),
      transparent calc(var(--edge) + var(--feather))
    );
  }

  .nav {
    max-width: var(--nh-measure-max);
    margin: 0 auto;
    padding: 18px var(--nh-spacing-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }

  .brand-mark {
    width: 42px;
    height: auto;
  }

  .brand-word {
    height: 22px;
    width: auto;
    opacity: 0.96;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .pill {
    border: 1px solid var(--nh-theme-line);
    background: rgba(255, 255, 255, 0.055);
    color: rgba(255, 255, 255, 0.82);
    border-radius: var(--nh-radii-rounded);
    padding: 10px 14px;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pill:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-1px);
  }

  .pill[aria-current='page'] {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--nh-theme-line-strong);
  }

  @media (max-width: 640px) {
    .nav {
      padding: 14px 16px;
    }

    .brand-word {
      display: none;
    }

    /* One scrolling row. flex-start is required: under flex-end the overflow
       sits off the left edge, clipped and unscrollable. */
    .nav-links {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }

    .pill {
      white-space: nowrap;
    }
  }
</style>
